---
/**
 * SiteSage — Safety Zones
 * Route: /zones
 * Interactive geofence designer + rule builder
 */
import Layout from '../layouts/Layout.astro';
import HumanoidWorker from '../components/HumanoidWorker.astro';
import WorkerProfileModal from '../components/WorkerProfileModal.astro';

const zones = [
  { id:'z-crane',    name:'Crane Swing Radius',  type:'Restricted',   camera:'CAM-04', severity:'critical', active:true,  workers:0, breaches:7,  color:'#EF4444' },
  { id:'z-hv',       name:'HV Zone — East Grid', type:'Danger',       camera:'CAM-03', severity:'critical', active:true,  workers:1, breaches:3,  color:'#EF4444' },
  { id:'z-trench',   name:'Trench Edge Buffer',  type:'Restricted',   camera:'CAM-02', severity:'high',     active:true,  workers:2, breaches:2,  color:'#F59E0B' },
  { id:'z-laydown',  name:'Material Laydown',    type:'PPE Required', camera:'CAM-01', severity:'medium',   active:false, workers:8, breaches:0,  color:'#3B82F6' },
  { id:'z-gate-c',   name:'Gate C Access Zone',  type:'Entry/Exit',   camera:'CAM-05', severity:'medium',   active:true,  workers:3, breaches:1,  color:'#3B82F6' },
];
---

<Layout
  title="Safety Zones"
  breadcrumb={['Site Dashboard', 'Safety Zones']}
  activePage="zones"
>

<!-- PAGE HEADER -->
<div class="page-header">
  <div>
    <h1 class="page-title">Safety Zones</h1>
    <p class="page-subtitle">Geofence configuration, zone rules, and boundary monitoring</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost btn-sm" id="import-zones-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      Import
    </button>
    <button class="btn btn-primary btn-sm" id="new-zone-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      New Zone
    </button>
  </div>
</div>

<!-- TRI-PANE: LEFT LIST | CENTER CANVAS | RIGHT CONFIG -->
<div class="zones-workspace">

  <!-- LEFT: ZONE LIST -->
  <div class="zones-list">
    <div class="card" style="padding:0;overflow:hidden;">
      <div class="panel-header">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-secondary)" stroke-width="1.8" aria-hidden="true">
          <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/>
        </svg>
        <span class="panel-title">Zones</span>
        <span class="badge badge-neutral" style="font-size:9px;margin-left:auto;">{zones.length}</span>
      </div>

      <div style="padding:6px;">
        {zones.map((zone, i) => (
          <div
            class={`zone-list-item ${i === 0 ? 'active' : ''}`}
            data-zone-id={zone.id}
          >
            <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
              <button class="zone-select" aria-pressed={i === 0 ? 'true' : 'false'} style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;text-align:left;">
                <div style={`width:10px;height:10px;border-radius:2px;background:${zone.color};flex-shrink:0;`} aria-hidden="true"></div>
                <div style="min-width:0;">
                  <div style="font-size:var(--text-xs);font-weight:var(--weight-semibold);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    {zone.name}
                  </div>
                  <div style="font-size:var(--text-technical);color:var(--color-text-tertiary);font-family:var(--font-mono);">
                    {zone.type} · {zone.camera}
                  </div>
                </div>
              </button>
              <div style="flex-shrink:0;display:flex;align-items:center;gap:4px;">
                <button
                  class="toggle"
                  role="switch"
                  aria-checked={String(zone.active)}
                  aria-label={`${zone.active ? 'Disable' : 'Enable'} ${zone.name}`}
                  style="width:28px;height:16px;"
                ></button>
              </div>
            </div>
            {zone.breaches > 0 && (
              <div style="margin-top:4px;font-size:9px;color:var(--color-critical);font-weight:var(--weight-bold);">
                {zone.breaches} breach{zone.breaches > 1 ? 'es' : ''} today
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Add zone button -->
    <button class="btn btn-ghost" style="justify-content:center;" id="draw-zone-btn">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/>
        <line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
      Draw New Zone
    </button>
  </div>

  <!-- CENTER: CANVAS -->
  <div class="card zones-canvas-panel">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>
      </svg>
      <span class="panel-title" id="canvas-label">Sector B — Crane Zone · CAM-04</span>
      <div class="panel-actions">
        <span class="badge badge-neutral" style="font-size:9px;" id="draw-mode-badge">SELECT MODE</span>
        <button class="btn-icon" title="Toggle grid" aria-label="Toggle grid overlay" id="grid-toggle">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
        </button>
        <button class="btn btn-sm" style="font-size:9px;background:var(--color-critical-bg);color:var(--color-critical);border:1px solid rgba(239,68,68,0.3);" id="draw-btn">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Draw Polygon
        </button>
      </div>
    </div>

    <!-- Canvas area -->
    <div id="zone-canvas" role="img" aria-label="Zone drawing canvas — Sector B Crane Zone">

      <!-- Site background SVG -->
      <svg id="canvas-scene" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid meet" width="100%" height="100%" style="position:absolute;inset:0;" aria-hidden="true">
        <defs>
          <pattern id="grid-pat" width="30" height="30" patternUnits="userSpaceOnUse">
            <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(59,130,246,0.06)" stroke-width="0.5"/>
          </pattern>
          <pattern id="hatch-red" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="4" x2="8" y2="4" stroke="rgba(239,68,68,0.2)" stroke-width="1.5"/>
          </pattern>
          <pattern id="hatch-amber" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="4" x2="8" y2="4" stroke="rgba(245,158,11,0.2)" stroke-width="1.5"/>
          </pattern>
          <pattern id="hatch-blue" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="4" x2="8" y2="4" stroke="rgba(59,130,246,0.15)" stroke-width="1.5"/>
          </pattern>
        </defs>

        <!-- Grid overlay (shown by default) -->
        <rect id="grid-rect" width="100%" height="100%" fill="url(#grid-pat)"/>

        <!-- Scene background -->
        <rect width="100%" height="100%" fill="#060d1a"/>
        <rect id="grid-rect2" width="100%" height="100%" fill="url(#grid-pat)"/>

        <!-- Building wireframe -->
        <rect x="60" y="40" width="220" height="280" fill="#091528" stroke="#152238" stroke-width="1"/>
        {[80,120,160,200,240,280].map(y => (
          <line x1="60" y1={y} x2="280" y2={y} stroke="#152238" stroke-width="0.5"/>
        ))}
        {[100,140,180,220,260].map(x => (
          <line x1={x} y1="40" x2={x} y2="320" stroke="#152238" stroke-width="0.5"/>
        ))}

        <!-- Crane arm -->
        <rect x="340" y="10" width="5" height="370" fill="#0d1c38"/>
        <rect x="340" y="20" width="140" height="4" fill="#0d1c38"/>

        <!-- ZONE 1: Crane Swing (critical) — active -->
        <polygon id="zone-crane" points="310,50 520,45 530,350 300,355"
          fill="url(#hatch-red)"
          stroke="#EF4444" stroke-width="1.5" stroke-dasharray="8,4" opacity="0.85"/>

        <!-- Zone label -->
        <text x="415" y="200" text-anchor="middle" font-family="monospace" font-size="9" fill="rgba(239,68,68,0.7)" letter-spacing="0.06em">CRANE SWING RADIUS</text>
        <text x="415" y="215" text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(239,68,68,0.5)">RESTRICTED · CAM-04</text>

        <!-- Zone vertex handles -->
        {[[310,50],[520,45],[530,350],[300,355]].map(([vx,vy], i) => (
          <circle cx={vx} cy={vy} r="5" fill="#EF4444" stroke="white" stroke-width="1.5"
            style="cursor:move;" class="zone-vertex"
            aria-label={`Vertex ${i+1}`}/>
        ))}

        <!-- ZONE 2: HV Zone (amber) -->
        <polygon points="60,40 280,40 280,110 60,110"
          fill="url(#hatch-amber)"
          stroke="#F59E0B" stroke-width="1" stroke-dasharray="6,4" opacity="0.7"/>
        <text x="170" y="82" text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(245,158,11,0.7)" letter-spacing="0.05em">HV ZONE</text>

        <!-- ZONE 3: Material laydown (blue, inactive) -->
        <polygon points="60,290 200,290 200,360 60,360"
          fill="url(#hatch-blue)"
          stroke="#3B82F6" stroke-width="1" stroke-dasharray="4,4" opacity="0.4"/>
        <text x="130" y="330" text-anchor="middle" font-family="monospace" font-size="8" fill="rgba(59,130,246,0.5)">MATERIAL LAYDOWN</text>
        <text x="130" y="342" text-anchor="middle" font-family="monospace" font-size="7" fill="rgba(59,130,246,0.35)">INACTIVE</text>

        <!-- Realistic articulated human tradespeople in scene -->
        <!-- Worker 1: Marcus Vance in crane zone (Violations: Radius Breach & Hard Hat missing) -->
        <g id="worker-marcus-zone" class="worker-interactive" data-open-worker-modal="WORKER-024" style="cursor:pointer;">
          <!-- Bounding box with detection banner -->
          <rect x="365" y="116" width="56" height="96" fill="none" stroke="#EF4444" stroke-width="1.5" stroke-dasharray="4,2"/>
          <rect x="365" y="103" width="94" height="14" rx="2" fill="#EF4444"/>
          <text x="368" y="113" fill="#FFFFFF" font-size="7.5" font-family="monospace" font-weight="bold">MARCUS VANCE · 94%</text>
          
          <HumanoidWorker
            x={372}
            y={116}
            scale={0.68}
            pose="walking-tool"
            hasHelmet={false}
            vestColor="orange"
            isAlert={true}
            workerName="Marcus 'Mack' Vance"
            workerTrade="Journeyman Ironworker"
            workerId="WORKER-024"
          />

          <!-- Floating violation tag -->
          <g transform="translate(355, 216)">
            <rect x="0" y="0" width="118" height="15" rx="2" fill="#0D1527" stroke="#EF4444" stroke-width="1"/>
            <text x="59" y="10.5" text-anchor="middle" font-family="monospace" font-size="7" fill="#EF4444" font-weight="bold">⚠ CRANE RADIUS BREACH</text>
          </g>
        </g>

        <!-- Worker 2: Elena Chen (Site Engineer) in compliant PPE -->
        <g id="worker-elena-zone" class="worker-interactive" data-open-worker-modal="ENG-012" style="cursor:pointer;">
          <rect x="135" y="152" width="48" height="94" fill="none" stroke="#10B981" stroke-width="1.2" opacity="0.8"/>
          <rect x="135" y="140" width="80" height="13" rx="2" fill="#10B981"/>
          <text x="138" y="149" fill="#091528" font-size="7" font-family="monospace" font-weight="bold">ELENA CHEN (ENG)</text>
          
          <HumanoidWorker
            x={138}
            y={150}
            scale={0.66}
            pose="standing-tablet"
            hasHelmet={true}
            helmetColor="#FFFFFF"
            vestColor="lime"
            isAlert={false}
            workerName="Elena Rostova-Chen"
            workerTrade="Lead Site Engineer"
            workerId="ENG-012"
          />
        </g>

        <!-- Drawing cursor indicator (shown in draw mode) -->
        <g id="draw-cursor" style="display:none;" aria-hidden="true">
          <circle r="4" fill="rgba(59,130,246,0.6)" stroke="#3B82F6" stroke-width="1.5" id="draw-cursor-dot"/>
          <circle r="12" fill="none" stroke="rgba(59,130,246,0.3)" stroke-width="1" id="draw-cursor-ring"/>
        </g>
      </svg>

      <!-- Status overlay -->
      <div style="position:absolute;top:8px;left:8px;font-family:var(--font-mono);font-size:8px;color:rgba(6,182,212,0.7);line-height:1.8;" aria-hidden="true">
        <div>CAM-04 · SECTOR B</div>
        <div data-live-clock style="color:rgba(6,182,212,0.5);">14:43:17 PM</div>
        <div id="draw-instructions" style="color:rgba(59,130,246,0.6);display:none;">CLICK TO ADD POINT · DOUBLE CLICK TO CLOSE</div>
      </div>

      <div class="hud-corner hud-tl" style="opacity:0.3;" aria-hidden="true"></div>
      <div class="hud-corner hud-br" style="opacity:0.3;" aria-hidden="true"></div>
    </div>
  </div>

  <!-- RIGHT: RULE CONFIG -->
  <div class="zones-config">

    <div class="card" style="padding:0;overflow:hidden;">
      <div class="panel-header">
        <span class="panel-title">Zone Configuration</span>
      </div>
      <div style="padding:16px;display:flex;flex-direction:column;gap:14px;">

        <!-- Zone name -->
        <div>
          <label class="drawer-section-title" for="zone-name-input">Zone Name</label>
          <input class="input" id="zone-name-input" type="text" value="Crane Swing Radius" style="margin-top:5px;"/>
        </div>

        <!-- Zone type -->
        <div>
          <div class="drawer-section-title" style="margin-bottom:6px;">Zone Type</div>
          <div style="display:flex;flex-direction:column;gap:4px;" role="radiogroup" aria-label="Zone type">
            {[
              { type:'Restricted',   color:'var(--color-critical)', desc:'No entry permitted' },
              { type:'Danger',       color:'var(--color-critical)', desc:'Authorised entry only' },
              { type:'PPE Required', color:'var(--color-warning)',  desc:'Full PPE mandatory' },
              { type:'Entry/Exit',   color:'var(--color-primary-hover)', desc:'Access control point' },
            ].map((zt, i) => (
              <label style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--color-border);border-radius:6px;cursor:pointer;" for={`zt-${i}`}>
                <input type="radio" name="zone-type" id={`zt-${i}`} value={zt.type} checked={i === 0} style="accent-color:var(--color-primary);"/>
                <div style={`width:8px;height:8px;border-radius:2px;background:${zt.color};flex-shrink:0;`} aria-hidden="true"></div>
                <div>
                  <div style="font-size:var(--text-sm);font-weight:var(--weight-medium);">{zt.type}</div>
                  <div style="font-size:9px;color:var(--color-text-tertiary);">{zt.desc}</div>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Severity -->
        <div>
          <label class="drawer-section-title" for="zone-severity" style="display:block;margin-bottom:5px;">Alert Severity</label>
          <select class="input" id="zone-severity" style="height:32px;font-size:var(--text-xs);">
            <option>Critical — Immediate alert</option>
            <option>High — Alert within 60s</option>
            <option>Medium — Batch alert</option>
          </select>
        </div>

        <!-- Dwell time -->
        <div>
          <label class="drawer-section-title" for="dwell-time" style="display:block;margin-bottom:5px;">Dwell Threshold</label>
          <div style="display:flex;align-items:center;gap:8px;">
            <input class="range-input" id="dwell-time" type="range" min="1" max="30" value="3" style="flex:1;" aria-label="Dwell time in seconds"/>
            <span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--color-cyan);white-space:nowrap;min-width:40px;" id="dwell-val">3 sec</span>
          </div>
          <div style="font-size:9px;color:var(--color-text-tertiary);margin-top:3px;">Alert if person stays longer than this threshold</div>
        </div>
      </div>
    </div>

    <!-- RULE BUILDER -->
    <div class="card" style="padding:0;overflow:hidden;">
      <div class="panel-header">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-hover)" stroke-width="1.8" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        <span class="panel-title">Rule Preview</span>
      </div>
      <div style="padding:14px;font-size:var(--text-sm);line-height:2.2;">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <span class="badge badge-neutral">IF</span>
          <span style="color:var(--color-text-primary);font-weight:var(--weight-semibold);">Person</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-left:20px;border-left:2px solid var(--color-border);margin:4px 0 4px 8px;">
          <span class="badge badge-critical">ENTERS</span>
          <span style="color:var(--color-critical);font-weight:var(--weight-semibold);">Crane Swing Radius</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <span class="badge badge-neutral">AND STAYS</span>
          <span style="color:var(--color-text-primary);font-weight:var(--weight-semibold);">&gt; 3 seconds</span>
        </div>
        <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--color-border);">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span class="badge badge-neutral">THEN</span>
          </div>
          <div style="margin-top:6px;padding-left:16px;display:flex;flex-direction:column;gap:4px;">
            <div style="display:flex;align-items:center;gap:6px;font-size:var(--text-xs);">
              <span class="status-dot critical" aria-hidden="true"></span>
              <span>Create <strong>Critical Incident</strong></span>
            </div>
            <div style="display:flex;align-items:center;gap:6px;font-size:var(--text-xs);">
              <span class="status-dot warning" aria-hidden="true"></span>
              <span>Notify <strong>Site Supervisor</strong></span>
            </div>
            <div style="display:flex;align-items:center;gap:6px;font-size:var(--text-xs);">
              <span class="status-dot safe" aria-hidden="true"></span>
              <span>Log <strong>Evidence Frame</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Save actions -->
    <div style="display:flex;gap:8px;">
      <button class="btn btn-ghost" style="flex:1;justify-content:center;">Cancel</button>
      <button class="btn btn-primary" style="flex:1;justify-content:center;">Save Zone</button>
    </div>
  </div>
</div>

<style>
  .zones-workspace { display: grid; grid-template-columns: 220px minmax(0, 1fr) 280px; gap: 20px; align-items: start; }
  .zones-workspace > * { min-width: 0; }
  .zones-list, .zones-config { display: flex; flex-direction: column; gap: 16px; }
  .zones-canvas-panel { display: flex; flex-direction: column; overflow: hidden; }
  #zone-canvas { position: relative; background: #060d1a; width: 100%; aspect-ratio: 3 / 2; min-height: 320px; cursor: crosshair; }
  @media (max-width: 1280px) { .zones-workspace { grid-template-columns: 220px minmax(0, 1fr); } .zones-config { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  @media (max-width: 700px) { .zones-workspace { grid-template-columns: minmax(0, 1fr); } .zones-config { display: flex; } #zone-canvas { min-height: 240px; } .zones-list { min-width: 0; } }
  .zone-list-item {
    width: 100%;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background var(--duration-fast), border-color var(--duration-fast);
    margin-bottom: 2px;
    display: block;
  }
  .zone-list-item:hover { background: var(--color-surface-hover); border-color: var(--color-border); }
  .zone-list-item.active { background: var(--color-primary-bg); border-color: rgba(59,130,246,0.25); }
  .zone-select { min-height: 40px; }

  .toggle {
    width: 28px !important;
    height: 16px !important;
  }
  .toggle::after { width: 12px !important; height: 12px !important; }
  .toggle[aria-checked="true"]::after { transform: translateX(12px) !important; }
</style>

<script>
  // Zone list item selection
  document.querySelectorAll('.zone-list-item').forEach(item => {
    item.querySelector('.zone-select')?.addEventListener('click', () => {
      document.querySelectorAll('.zone-list-item').forEach(i => {
        i.classList.remove('active');
        i.querySelector('.zone-select')?.setAttribute('aria-pressed', 'false');
      });
      item.classList.add('active');
      item.querySelector('.zone-select')?.setAttribute('aria-pressed', 'true');
    });
  });

  // Toggle switches
  document.querySelectorAll('.toggle[role="switch"]').forEach(sw => {
    sw.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOn = sw.getAttribute('aria-checked') === 'true';
      sw.setAttribute('aria-checked', String(!isOn));
      (sw as HTMLElement).style.background = !isOn ? 'var(--color-primary)' : '';
    });
    // Init colors
    if (sw.getAttribute('aria-checked') === 'true') {
      (sw as HTMLElement).style.background = 'var(--color-primary)';
    }
  });

  // Dwell slider
  const dwellSlider = document.getElementById('dwell-time') as HTMLInputElement;
  const dwellVal    = document.getElementById('dwell-val')!;
  dwellSlider?.addEventListener('input', () => {
    dwellVal.textContent = dwellSlider.value + ' sec';
  });

  // Draw mode toggle
  let drawMode = false;
  const drawBtn          = document.getElementById('draw-btn')!;
  const drawModeEl       = document.getElementById('draw-mode-badge')!;
  const drawInstructions = document.getElementById('draw-instructions')!;
  const drawCursor       = document.getElementById('draw-cursor')!;
  const canvas           = document.getElementById('zone-canvas')!;
  const drawCursorDot    = document.getElementById('draw-cursor-dot')!;
  const drawCursorRing   = document.getElementById('draw-cursor-ring')!;

  const points: [number, number][] = [];
  let drawPolyEl: SVGPolygonElement | null = null;
  let drawLineEl: SVGPolylineElement | null = null;
  const canvasSVG = document.getElementById('canvas-scene') as unknown as SVGSVGElement;
  function canvasPoint(event: MouseEvent): [number, number] {
    const matrix = canvasSVG.getScreenCTM();
    if (!matrix) return [0, 0];
    const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
    return [point.x, point.y];
  }
  ['new-zone-btn', 'draw-zone-btn'].forEach(id => document.getElementById(id)?.addEventListener('click', () => {
    if (!drawMode) drawBtn.click();
    canvas.scrollIntoView({ block: 'center', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  }));

  drawBtn?.addEventListener('click', () => {
    drawMode = !drawMode;
    drawModeEl.textContent = drawMode ? 'DRAW MODE' : 'SELECT MODE';
    drawModeEl.className   = drawMode ? 'badge badge-primary' : 'badge badge-neutral';
    canvas.style.cursor    = drawMode ? 'crosshair' : 'default';
    drawInstructions.style.display = drawMode ? 'block' : 'none';
    drawCursor.style.display       = drawMode ? '' : 'none';
    (drawBtn as HTMLElement).style.background = drawMode ? 'var(--color-primary-bg)' : '';
    if (!drawMode) { points.length = 0; drawPolyEl?.remove(); drawLineEl?.remove(); drawPolyEl = null; drawLineEl = null; }
  });

  canvas.addEventListener('mousemove', (e) => {
    if (!drawMode) return;
    const [x, y] = canvasPoint(e);
    drawCursorDot.setAttribute('cx', String(x));
    drawCursorDot.setAttribute('cy', String(y));
    drawCursorRing.setAttribute('cx', String(x));
    drawCursorRing.setAttribute('cy', String(y));

    if (drawLineEl && points.length > 0) {
      const pts = [...points, [x, y]].map(p => p.join(',')).join(' ');
      drawLineEl.setAttribute('points', pts);
    }
  });

  canvas.addEventListener('click', (e) => {
    if (!drawMode) return;
    const [x, y] = canvasPoint(e);
    points.push([x, y]);

    if (!drawPolyEl) {
      drawPolyEl = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      drawPolyEl.setAttribute('fill', 'rgba(59,130,246,0.1)');
      drawPolyEl.setAttribute('stroke', '#3B82F6');
      drawPolyEl.setAttribute('stroke-width', '1.5');
      drawPolyEl.setAttribute('stroke-dasharray', '6,3');
      canvasSVG.appendChild(drawPolyEl);
    }
    if (!drawLineEl) {
      drawLineEl = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
      drawLineEl.setAttribute('fill', 'none');
      drawLineEl.setAttribute('stroke', '#3B82F6');
      drawLineEl.setAttribute('stroke-width', '1');
      drawLineEl.setAttribute('stroke-dasharray', '4,3');
      canvasSVG.appendChild(drawLineEl);
    }

    drawPolyEl.setAttribute('points', points.map(p => p.join(',')).join(' '));

    // Add vertex dot
    const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dot.setAttribute('cx', String(x)); dot.setAttribute('cy', String(y)); dot.setAttribute('r', '4');
    dot.setAttribute('fill', '#3B82F6'); dot.setAttribute('stroke', 'white'); dot.setAttribute('stroke-width', '1.5');
    canvasSVG.appendChild(dot);
  });

  canvas.addEventListener('dblclick', () => {
    if (!drawMode || points.length < 3) return;
    drawMode = false;
    drawModeEl.textContent = 'SELECT MODE';
    drawModeEl.className = 'badge badge-safe';
    canvas.style.cursor = 'default';
    drawInstructions.style.display = 'none';
    drawCursor.style.display = 'none';
    (drawBtn as HTMLElement).style.background = '';
    drawLineEl?.remove(); drawLineEl = null;
    // Finalise polygon
    if (drawPolyEl) {
      drawPolyEl.setAttribute('stroke-dasharray', '8,4');
      drawPolyEl.setAttribute('stroke', '#10B981');
      drawPolyEl.setAttribute('fill', 'rgba(16,185,129,0.08)');
    }
    points.length = 0;
    alert('Zone polygon saved! Assign a name and rules in the configuration panel, then click "Save Zone".');
  });
</script>

