---
import '../styles/global.css';
import '../styles/refinement.css';
import '../styles/landing.css';
import '../styles/landing-motion.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SiteSage turns existing construction cameras into reviewable safety events. Explore the live prototype and TinyFish safety research." />
  <meta name="theme-color" content="#0B1220" />
  <meta property="og:title" content="SiteSage | Construction AI Safety Platform" />
  <meta property="og:description" content="See risks earlier. Give your team evidence to act. Explore the SiteSage prototype." />
  <title>SiteSage | AI-Powered Construction Safety Command Center</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body class="landing">
  <div class="welcome-screen" id="welcome-screen" role="dialog" aria-modal="true" aria-label="Welcome to SiteSage" hidden>
    <button class="welcome-skip" id="welcome-skip">Skip intro ↗</button>
    <div class="welcome-content"><img class="welcome-mark" src="/favicon.svg" alt="" width="64" height="64" /><p class="welcome-label">Welcome to</p><div class="welcome-wordmark" aria-label="SiteSage">{'SiteSage'.split('').map(letter => <span aria-hidden="true">{letter}</span>)}</div><p class="welcome-caption">Detect. Review. Respond.</p></div>
    <div class="welcome-line" aria-hidden="true"></div>
  </div>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <nav class="landing-nav" id="landing-nav" aria-label="Main navigation">
    <a href="/" class="brand" aria-label="SiteSage home"><img src="/favicon.svg" width="30" height="30" alt="" /><span class="brand-name">SiteSage</span></a>
    <div class="landing-links"><a href="#how-it-works">How It Works</a><a href="#features">Features</a><a href="#trust">Trust & Privacy</a></div>
    <a class="landing-enter" href="/dashboard">Enter Platform <span aria-hidden="true">↗</span></a>
  </nav>
  <main id="main-content">
    <section class="landing-hero" id="hero" aria-labelledby="hero-title">
      <div class="hero-eyebrow">Construction safety intelligence</div>
      <h1 id="hero-title">See risk.<br />Protect <em>people.</em></h1>
      <div class="hero-bottom"><span class="hero-principle">Detect, <em>don't decide.</em></span><div class="hero-description"><p>Turn existing cameras into safety evidence. Help your team spot risks, review events, and respond sooner.</p><a href="/dashboard" class="landing-cta">Explore demo <span aria-hidden="true">↗</span></a></div></div>
    </section>
    <section class="product-preview" aria-label="SiteSage dashboard preview">
      <div class="preview-toolbar"><span><span class="preview-dot" aria-hidden="true"></span> SiteSage command center</span><span>Interactive prototype / simulated data</span></div>
      <a href="/dashboard" aria-label="Open the interactive SiteSage dashboard"><img src="/dashboard-preview.png" width="1440" height="960" alt="SiteSage prototype showing a construction camera feed, PPE detections, safety events and operational metrics." fetchpriority="high" /></a>
      <div class="preview-caption"><p>One place to see what needs attention.</p><a href="/monitoring">Explore camera views ↗</a></div>
    </section>
    <section class="workflow-section landing-section" id="how-it-works" aria-labelledby="workflow-title">
      <h2 id="workflow-title">From passive video<br />to <em>active awareness.</em></h2>
      <p class="section-intro">Your cameras are the starting point. A reviewable event is the result.</p>
      <div class="workflow-list">
        {[
          {title:'Connect existing cameras', text:'RTSP and ONVIF-compatible feeds are the proposed entry point. Keep suitable cameras and add an intelligence layer.', tag:'Camera → Edge'},
          {title:'Detect and apply rules', text:'Identify people, helmets and safety vests. Combine detections with configured zones to flag possible safety events.', tag:'Vision → Risk'},
          {title:'Review the evidence', text:'Bring snapshots, confidence and event context to a safety officer. People verify the event and choose the response.', tag:'Evidence → Review'},
        ].map(item => <article class="workflow-row"><h3>{item.title}</h3><p>{item.text}</p><span>{item.tag}</span></article>)}
      </div>
    </section>
    <section class="capabilities-section landing-section" id="features" aria-labelledby="features-title">
      <h2 id="features-title">Less searching.<br /><em>More clarity.</em></h2>
      <div class="capabilities-grid">
        <a class="capability feature-monitor" href="/monitoring"><span class="feature-tag">Observe</span><h3>The whole site.<br />In one view.</h3><p>Explore camera health, detection overlays and the monitoring workflow.</p><span class="feature-link">Live Monitoring ↗</span></a>
        <a class="capability feature-incidents" href="/incidents"><span class="feature-tag">Investigate</span><h3>Every event has<br />a <em>story.</em></h3><p>Filter incidents, review evidence and keep human verification visible.</p><span class="feature-link">Incidents ↗</span></a>
        <a class="capability feature-research" href="/research"><span class="feature-tag">Understand / TinyFish</span><h3>Bring the web<br />into the workflow.</h3><p>Read official safety guidance with a web agent. Track progress and inspect its source.</p><span class="feature-link">Safety research ↗</span></a>
        <a class="capability feature-zones" href="/zones"><span class="feature-tag">Configure</span><h3>Draw the line.<br /><em>Set the rule.</em></h3><p>Explore restricted areas, camera zones and configurable safety conditions.</p><span class="feature-link">Safety Zones ↗</span></a>
      </div>
    </section>
    <section class="trust-section landing-section" id="trust" aria-labelledby="trust-title">
      <div class="trust-statement"><h2 id="trust-title">Technology sees.<br /><em>Your team decides.</em></h2><p>Assist trained personnel, keep critical decisions human, and measure performance before making claims.</p></div>
      <div class="trust-details"><article><h3>Edge-first by design</h3><p>The proposed architecture processes video near the site. Camera feeds and worker identities are not sent to the TinyFish research agent.</p></article><article><h3>Evidence before action</h3><p>Detections flag possible events. Authorized personnel review them before deciding what happened.</p></article><article><h3>A prototype you can inspect</h3><p>Camera scenes and operational metrics are simulated. Real-world accuracy, latency and field robustness still need validation.</p></article></div>
    </section>
    <section class="closing-section kinetic-finale" aria-labelledby="finale-title">
      <div class="finale-header"><h2 id="finale-title">Safety is<br /><em>in your hands.</em></h2><a class="landing-cta" href="/dashboard">Enter Platform <span aria-hidden="true">↗</span></a></div>
      <button class="btn btn-ghost physics-enable" id="physics-enable" hidden>Play letter animation ↗</button>
      <div class="physics-stage" id="physics-stage" role="region" tabindex="0" aria-label="Interactive SiteSage letters" aria-describedby="physics-help">
        <div class="physics-letters" aria-hidden="true">{'SITESAGE'.split('').map((letter, index) => <span class="physics-letter" data-letter={index}>{letter}</span>)}</div>
        <div class="physics-floor" aria-hidden="true"></div>
        <div class="physics-controls"><p id="physics-help">Letters fall from above. Scroll inside for more. Grab and drag to play.</p><div><button id="physics-stir" class="btn btn-ghost">Stir letters ↗</button><button id="physics-reset" class="btn btn-ghost">Drop again ↻</button></div></div>
      </div>
    </section>
  </main>
  <footer class="landing-footer"><a class="brand" href="/">SiteSage</a><p>Construction safety. Human judgement.</p><a href="/research">Powered by TinyFish ↗</a></footer>
  <script>
    import { initLandingMotion } from '../lib/landing-motion';
    initLandingMotion();
  </script>
</body>
</html>
