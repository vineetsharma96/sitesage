---
/**
 * SiteSage — Command Center Dashboard
 * Route: /dashboard
 * The primary operational screen — tri-pane: Live Feed + Alerts + Analytics
 */
import Layout from '../layouts/Layout.astro';
import HumanoidWorker from '../components/HumanoidWorker.astro';
import RadioIntercomWidget from '../components/RadioIntercomWidget.astro';
import ToolboxBriefingCard from '../components/ToolboxBriefingCard.astro';
import WorkerProfileModal from '../components/WorkerProfileModal.astro';
import { WORKERS } from '../data/mockData';
---

<Layout
  title="Dashboard"
  breadcrumb={['Site Dashboard', 'Command Center']}
  activePage="dashboard"
>

<!-- ── OPERATIONAL STATUS STRIP ───────────────────────── -->
<div class="workspace-intro">
  <div><h1 class="page-title">A clearer view. <em>A safer site.</em></h1><p class="page-subtitle">Your camera feeds, safety events and response workflow in one place. Simulated prototype data.</p></div>
  <a href="/research" class="btn btn-ghost">Safety research ↗</a>
</div>
<div class="ops-status-strip" role="status" aria-label="Site operational status">
  <div class="ops-status-item">
    <span class="status-dot safe" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Site Status</div>
      <div class="ops-status-value safe" id="site-status-val">Operational</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-hover)" stroke-width="2" aria-hidden="true"><path d="M23 7 16 12 23 17V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
    <div>
      <div class="ops-status-label">Cameras</div>
      <div class="ops-status-value primary" id="cameras-val">22 / 24 Online</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <div>
      <div class="ops-status-label">Active Risks</div>
      <div class="ops-status-value warning" id="risks-val">7</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-critical)" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <div class="ops-status-label">Critical</div>
      <div class="ops-status-value critical" id="critical-val">2</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-safe)" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
    <div>
      <div class="ops-status-label">Compliance</div>
      <div class="ops-status-value safe" id="compliance-val">94.2%</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-secondary)" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <div>
      <div class="ops-status-label">Workers On-Site</div>
      <div class="ops-status-value" id="workers-val">142</div>
    </div>
  </div>
  <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
    <div style="font-family:var(--font-mono);font-size:var(--text-xxs);color:var(--color-text-tertiary);">
      Last sync: <span data-live-clock style="color:var(--color-cyan);">--:--:-- --</span>
    </div>
    <span class="badge badge-live" aria-label="Live monitoring active">● LIVE</span>
  </div>
</div>

<!-- ── TRI-PANE LAYOUT ────────────────────────────────── -->
<div class="tri-pane" id="tri-pane">

  <!-- ═══════════════════════════════════════════════
       LEFT + BOTTOM: CAMERA FEED + ANALYTICS
  ═══════════════════════════════════════════════ -->
  <div class="tri-left">

    <!-- CAMERA PANEL -->
    <div class="card" id="camera-panel" style="display:flex;flex-direction:column;min-height:0;">
      <div class="panel-header" style="gap:6px;">
        <!-- Camera selector -->
        <div style="display:flex;align-items:center;gap:6px;">
          <span class="status-dot live" aria-hidden="true"></span>
          <span class="panel-title" id="camera-panel-title">CAM-04 — Sector B · Crane Zone</span>
        </div>

        <div class="panel-actions">
          <!-- Camera selector dropdown -->
          <select
            id="camera-select"
            class="input"
            style="width:auto;padding:4px 8px;font-size:var(--text-xxs);font-family:var(--font-mono);height:28px;cursor:pointer;"
            aria-label="Select camera feed"
          >
            <option value="CAM-04">CAM-04 — Crane Zone</option>
            <option value="CAM-01">CAM-01 — Level 08</option>
            <option value="CAM-02">CAM-02 — Level 12</option>
            <option value="CAM-03">CAM-03 — Sector B Entry</option>
            <option value="CAM-05">CAM-05 — South Gate</option>
          </select>

          <!-- View mode toggle -->
          <div role="group" aria-label="View mode" style="display:flex;border:1px solid var(--color-border);border-radius:6px;overflow:hidden;">
            <button id="view-single" class="view-toggle-btn active" aria-pressed="true" aria-label="Single camera view" title="Single view">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
            </button>
            <button id="view-grid" class="view-toggle-btn" aria-pressed="false" aria-label="2x2 camera grid" title="Grid view">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
            </button>
          </div>

          <button class="btn-icon" title="Fullscreen" aria-label="Toggle fullscreen" id="fullscreen-btn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
      </div>

      <!-- ── SINGLE CAMERA VIEW ── -->
      <div id="single-view" class="cam-viewport" style="flex:1;border-radius:0;">
        <div class="cam-scene" style="min-height:340px;">
          <!-- Scan line -->
          <div class="scan-line" aria-hidden="true"></div>

          <!-- Simulated construction scene SVG -->
          <svg width="100%" height="100%" viewBox="0 0 680 382" preserveAspectRatio="xMidYMid slice"
               style="position:absolute;inset:0;" aria-hidden="true">
            <!-- Sky -->
            <defs>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#030810"/>
                <stop offset="100%" stop-color="#060d1a"/>
              </linearGradient>
              <linearGradient id="ground-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#0a1220"/>
                <stop offset="100%" stop-color="#060d1a"/>
              </linearGradient>
              <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="3" x2="6" y2="3" stroke="rgba(239,68,68,0.25)" stroke-width="1"/>
              </pattern>
            </defs>
            <rect width="680" height="382" fill="url(#sky)"/>

            <!-- Grid reference -->
            {[0,1,2,3,4,5].map(i => (
              <line x1={0} y1={60*i+20} x2={680} y2={60*i+20} stroke="rgba(255,255,255,0.02)" stroke-width="1"/>
            ))}

            <!-- Building skeleton left -->
            <rect x="30" y="60" width="200" height="280" fill="rgba(9,21,40,0.9)" stroke="#152238" stroke-width="1"/>
            {[100,140,180,220,260,300].map(y => (
              <line x1="30" y1={y} x2="230" y2={y} stroke="#152238" stroke-width="0.5"/>
            ))}
            {[80,130,180].map(x => (
              <line x1={x} y1="60" x2={x} y2="340" stroke="#152238" stroke-width="0.5"/>
            ))}

            <!-- Scaffolding mid-right -->
            <rect x="420" y="100" width="200" height="220" fill="rgba(7,15,30,0.9)" stroke="#152238" stroke-width="1"/>
            {[140,180,220,260,300].map(y => (
              <line x1="420" y1={y} x2="620" y2={y} stroke="#152238" stroke-width="0.5"/>
            ))}

            <!-- Crane -->
            <rect x="320" y="20" width="6" height="320" fill="#0d1c38"/>
            <rect x="320" y="30" width="140" height="4" fill="#0d1c38"/>
            <line x1="460" y1="34" x2="326" y2="200" stroke="#152238" stroke-width="0.5" stroke-dasharray="4,3"/>

            <!-- Ground / base -->
            <rect x="0" y="340" width="680" height="42" fill="url(#ground-grad)"/>

            <!-- Equipment silhouettes -->
            <rect x="240" y="270" width="80" height="50" rx="4" fill="#0a1625"/>
            <rect x="250" y="250" width="20" height="30" rx="2" fill="#0a1625"/>

            <!-- GEOFENCE ZONE (danger area) -->
            <polygon points="380,120 560,110 570,290 370,300"
              fill="url(#hatch)"
              stroke="#EF4444" stroke-width="1.5" stroke-dasharray="6,3" opacity="0.7"/>
            <text x="468" y="210" text-anchor="middle" font-family="monospace" font-size="8"
              fill="rgba(239,68,68,0.7)" letter-spacing="0.05em">RESTRICTED ZONE</text>
            <text x="468" y="222" text-anchor="middle" font-family="monospace" font-size="7"
              fill="rgba(239,68,68,0.5)">CRANE SWING AREA</text>

            <!-- Humanoid Worker 1 — COMPLIANT (Elena Rostova-Chen, Apex Lead Finisher) -->
            <HumanoidWorker
              x={90}
              y={160}
              scale={1.05}
              pose="standing-tablet"
              hasHelmet={true}
              helmetColor="#EAB308"
              vestColor="lime"
              workerName="Elena Rostova-Chen"
              workerTrade="Apex Concrete Lead"
              workerId="AC-0924"
            />

            <!-- Humanoid Worker 2 — VIOLATION (Marcus 'Mack' Vance, SteelCorp Ironworker) -->
            <HumanoidWorker
              x={440}
              y={150}
              scale={1.12}
              pose="walking-tool"
              hasHelmet={false}
              vestColor="orange"
              isAlert={true}
              workerName="Marcus 'Mack' Vance"
              workerTrade="SteelCorp Ironworker"
              workerId="SC-4891"
            />

            <!-- Humanoid Worker 3 — RIGGER IN BACKGROUND (Jorge Reyes, Metro Crane Rigger) -->
            <HumanoidWorker
              x={275}
              y={200}
              scale={0.72}
              pose="rigging-signal"
              hasHelmet={true}
              helmetColor="#FFFFFF"
              vestColor="lime"
              workerName="Jorge Reyes"
              workerTrade="Metro Crane Rigger"
              workerId="MC-1102"
            />
          </svg>

          <!-- COMPLIANT WORKER bounding box (Elena Chen) -->
          <div class="bbox bbox-compliant"
               style="left:12%;top:41%;width:11%;height:34%;cursor:pointer;"
               role="button"
               tabindex="0"
               data-open-worker-modal="AC-0924"
               title="Click to view Elena Chen's safety dossier"
               aria-label="Worker Elena Chen (Apex) — Compliant (96% confidence). Click to view safety dossier.">
            <div class="bbox-label bbox-label-compliant">Elena Chen (Apex) · PPE COMPLIANT · 96%</div>
          </div>

          <!-- VIOLATION bounding box (Marcus Vance) -->
          <div class="bbox bbox-critical"
               style="left:63%;top:38%;width:12%;height:36%;cursor:pointer;"
               id="violation-bbox"
               role="button"
               tabindex="0"
               data-open-worker-modal="SC-4891"
               title="Click to inspect Marcus Vance's violation and dispatch radio"
               aria-label="Safety violation: Marcus Vance (SteelCorp) — No Helmet (98% confidence). Click to open incident.">
            <div class="bbox-label bbox-label-critical">
              <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor" style="display:inline;margin-right:2px;" aria-hidden="true">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              </svg>
              Marcus Vance (SteelCorp) · NO HELMET · 98%
            </div>
          </div>

          <!-- Realistic CCTV On-Screen Display (OSD) -->
          <div class="cam-meta" aria-hidden="true">
            <div style="font-weight:700;letter-spacing:0.04em;color:#fff;">CAM-04 · SECTOR B (CRANE #2 RADIUS)</div>
            <div data-live-clock style="color:var(--color-safe);">2026-09-29 14:43:17.84 EST</div>
            <div>REC ● 4K (3840×2160) · 30.00 FPS · 8.4 Mbps · H.265</div>
            <div style="color:rgba(255,255,255,0.45);font-size:7.5px;margin-top:1px;">AZ: 142.4° · EL: -18.2° · SENSOR: SONY STARVIS II · GAIN: +6dB</div>
          </div>

          <!-- Status top right -->
          <div class="cam-status-overlay" aria-hidden="true">
            <span class="badge badge-live" style="font-size:9px;">● LIVE</span>
          </div>

          <!-- Video sensor ingestion indicator top right -->
          <div style="
            position:absolute;bottom:50px;right:8px;
            font-family:var(--font-mono);font-size:8px;
            color:rgba(6,182,212,0.8);
            background:rgba(0,0,0,0.55);padding:3px 6px;border-radius:3px;
          " aria-hidden="true">
            STREAM INGESTION · 21ms JITTER
          </div>

          <!-- HUD corners -->
          <div class="hud-corner hud-tl" aria-hidden="true"></div>
          <div class="hud-corner hud-tr" aria-hidden="true"></div>
          <div class="hud-corner hud-bl" aria-hidden="true"></div>
          <div class="hud-corner hud-br" aria-hidden="true"></div>
        </div>

        <!-- Video controls -->
        <div class="video-controls" aria-label="Video controls">
          <!-- Play/Pause -->
          <button class="btn-icon" id="play-pause-btn" aria-label="Pause live feed">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" id="play-icon" aria-hidden="true">
              <rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>
            </svg>
          </button>

          <!-- Timeline -->
          <div class="timeline-bar" role="slider" aria-label="Timeline" aria-valuemin="0" aria-valuemax="100" aria-valuenow="65" id="timeline-bar">
            <div class="timeline-progress" id="timeline-progress" style="width:65%;">
              <div class="timeline-thumb" id="timeline-thumb" aria-hidden="true"></div>
            </div>
            <!-- Incident markers -->
            <div style="position:absolute;left:40%;top:-4px;width:2px;height:10px;background:var(--color-critical);border-radius:1px;cursor:pointer;"
                 title="INC-0248 · 14:43:17" role="button" tabindex="0" aria-label="Incident at 14:43:17"></div>
            <div style="position:absolute;left:25%;top:-4px;width:2px;height:10px;background:var(--color-warning);border-radius:1px;cursor:pointer;"
                 title="INC-0247 · 14:38:44" role="button" tabindex="0" aria-label="Incident at 14:38:44"></div>
          </div>

          <div class="time-display" aria-label="Current time in feed">
            <span id="current-time">00:32</span> / LIVE
          </div>

          <!-- Resolution -->
          <span style="font-family:var(--font-mono);font-size:9px;color:var(--color-text-tertiary);">1080p</span>

          <!-- Volume -->
          <button class="btn-icon btn-sm" aria-label="Mute audio">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ── MULTI-CAMERA GRID VIEW (hidden by default) ── -->
      <div id="grid-view" style="display:none;" aria-hidden="true">
        <div class="cam-grid-2x2">
          {[
            { id:'CAM-01', name:'North Tower · L08',   status:'safe',     compliance:97 },
            { id:'CAM-02', name:'North Tower · L12',   status:'warning',  compliance:94 },
            { id:'CAM-03', name:'Sector B · Entry',    status:'critical', compliance:88 },
            { id:'CAM-04', name:'Sector B · Crane Zone',status:'critical', compliance:81 },
          ].map(cam => (
            <div class="cam-grid-cell" data-cam={cam.id}
                 role="button" tabindex="0"
                 aria-label={`${cam.id} — ${cam.name}. Click to switch to this feed.`}
                 data-open-drawer={cam.status === 'critical' ? '' : undefined}
                 data-detection={cam.status === 'critical' ? 'No Hard Hat Detected' : undefined}
                 data-camera={cam.id}
                 data-location={cam.name}
                 data-confidence={cam.status === 'critical' ? '98' : undefined}
                 data-severity={cam.status}>
              <!-- Mini scene -->
              <svg width="100%" height="100%" viewBox="0 0 280 157" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                <rect width="280" height="157" fill="#060d1a"/>
                {[0,1,2,3].map(i => <line x1={70*i} y1="0" x2={70*i} y2="157" stroke="#0d1c38" stroke-width="0.5"/>)}
                {[0,1].map(i => <line x1="0" y1={60*i+40} x2="280" y2={60*i+40} stroke="#0d1c38" stroke-width="0.5"/>)}
                <rect x="40" y="20" width="100" height="110" fill="#091528" stroke="#152238" stroke-width="0.5"/>
                {cam.status === 'critical' && (
                  <>
                    <circle cx="90" cy="70" r="12" fill="rgba(239,68,68,0.1)" stroke="#EF4444" stroke-width="1.5"/>
                    <text x="90" y="74" text-anchor="middle" font-size="7" fill="#EF4444">!</text>
                  </>
                )}
                {cam.status === 'safe' && (
                  <circle cx="90" cy="70" r="12" fill="rgba(16,185,129,0.1)" stroke="#10B981" stroke-width="1.5"/>
                )}
                {cam.status === 'warning' && (
                  <circle cx="90" cy="70" r="12" fill="rgba(245,158,11,0.1)" stroke="#F59E0B" stroke-width="1.5"/>
                )}
              </svg>

              <!-- Camera label -->
              <div class="cam-cell-label">{cam.id}</div>

              <!-- Status indicator -->
              <div style={`position:absolute;top:5px;right:5px;`}>
                <span class={`badge badge-${cam.status === 'safe' ? 'safe' : cam.status === 'critical' ? 'critical' : 'warning'}`}
                      style="font-size:8px;padding:1px 5px;">
                  {cam.status === 'safe' ? '✓' : cam.status === 'critical' ? '!' : '⚠'}
                  {cam.compliance}%
                </span>
              </div>

              <div class="cam-grid-overlay" aria-hidden="true"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ANALYTICS DECK -->
    <div class="analytics-grid" id="analytics-deck">

      <!-- Compliance trend chart -->
      <div class="card">
        <div class="panel-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-safe)" stroke-width="2" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <span class="panel-title">Safety Compliance</span>
          <div class="panel-actions">
            <span class="kpi-chip kpi-safe" style="font-size:var(--text-technical);">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
              94.2%
            </span>
          </div>
        </div>
        <div class="chart-area" aria-label="Safety compliance trend chart">
          <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
            {['M','T','W','T','F','S','S'].map((d,i) => (
              <span style="font-size:9px;color:var(--color-text-tertiary);text-align:center;flex:1;">{d}</span>
            ))}
          </div>
          <svg width="100%" height="80" viewBox="0 0 200 80" preserveAspectRatio="none" role="img" aria-label="Weekly compliance trend">
            <defs>
              <linearGradient id="compliance-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="rgba(16,185,129,0.2)"/>
                <stop offset="100%" stop-color="rgba(16,185,129,0)"/>
              </linearGradient>
            </defs>
            <!-- Data: [88, 91, 87, 93, 94, 92, 94] → mapped 0-80 → inverted -->
            <polyline
              points="0,50 28,42 57,53 85,36 114,30 142,38 171,30 200,30"
              fill="none" stroke="var(--color-safe)" stroke-width="1.8" stroke-linejoin="round"/>
            <polygon
              points="0,50 28,42 57,53 85,36 114,30 142,38 171,30 200,30 200,80 0,80"
              fill="url(#compliance-fill)"/>
            <!-- Target line -->
            <line x1="0" y1="20" x2="200" y2="20" stroke="rgba(16,185,129,0.2)" stroke-width="1" stroke-dasharray="3,3"/>
            <!-- Hover dots -->
            {[{x:0,y:50},{x:28,y:42},{x:57,y:53},{x:85,y:36},{x:114,y:30},{x:142,y:38},{x:171,y:30},{x:200,y:30}].map(p => (
              <circle cx={p.x} cy={p.y} r="3" fill="var(--color-safe)" opacity="0.5"/>
            ))}
          </svg>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;">
            <span class="tech-label">7-day avg: 91.3%</span>
            <span class="tech-label">Target: 95%</span>
          </div>
        </div>
      </div>

      <!-- Incident distribution bar chart -->
      <div class="card">
        <div class="panel-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6"  y1="20" x2="6"  y2="14"/>
          </svg>
          <span class="panel-title">Incident Distribution</span>
          <div class="panel-actions">
