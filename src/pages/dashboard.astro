        { id:'INC-0244', sev:'safe',     title:'PPE Compliance Restored',  worker:'Elena Chen', trade:'Lead Finisher', sub:'Apex Concrete', cam:'CAM-02 · Level 12',  time:'11m ago', conf:99 },
