  .field-tools > :global(*) { min-width: 0; }
  @media (max-width: 1200px) { .field-tools { grid-template-columns: minmax(0, 1fr); } }
  #alert-rail {
    grid-area: right;
    height: calc(100vh - var(--header-height) - 24px * 2 - 54px - 16px);
    position: sticky;
    top: 16px;
  }
  .analytics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 220px;
    gap: 16px;
  }
  .view-toggle-btn {
    width: 30px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: background var(--duration-fast), color var(--duration-fast);
    border: none;
  }
  .view-toggle-btn:hover  { background: var(--color-surface-2); color: var(--color-text-primary); }
  .view-toggle-btn.active { background: var(--color-primary-bg); color: var(--color-primary-hover); }

  @keyframes blip-pulse {
    0%, 100% { opacity: 0.4; r: 3; }
    50%       { opacity: 1;   }
  }

  @media (max-width: 1200px) {
    .analytics-grid { grid-template-columns: 1fr 1fr; }
    .analytics-grid > *:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 900px) {
    .tri-pane {
      grid-template-columns: 1fr;
      grid-template-areas: "left" "right";
    }
    #alert-rail {
      height: auto;
      position: static;
    }
    .analytics-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { requestIncidentContext } from '../lib/incident-context-client';
  // ── View toggle (single / grid) ────────────────────────
  const singleView   = document.getElementById('single-view')!;
  const gridView     = document.getElementById('grid-view')!;
  const btnSingle    = document.getElementById('view-single')!;
  const btnGrid      = document.getElementById('view-grid')!;

  function showSingle() {
    singleView.style.display = '';
    singleView.removeAttribute('aria-hidden');
    gridView.style.display   = 'none';
    gridView.setAttribute('aria-hidden', 'true');
    btnSingle.classList.add('active');
    btnSingle.setAttribute('aria-pressed', 'true');
    btnGrid.classList.remove('active');
    btnGrid.setAttribute('aria-pressed', 'false');
  }
  function showGrid() {
    gridView.style.display   = '';
    gridView.removeAttribute('aria-hidden');
    singleView.style.display = 'none';
    singleView.setAttribute('aria-hidden', 'true');
    btnGrid.classList.add('active');
    btnGrid.setAttribute('aria-pressed', 'true');
    btnSingle.classList.remove('active');
    btnSingle.setAttribute('aria-pressed', 'false');
  }
  btnSingle.addEventListener('click', showSingle);
  btnGrid.addEventListener('click', showGrid);

  // ── Timeline progress ──────────────────────────────────
  let progress = 65;
  const progressBar = document.getElementById('timeline-progress')!;
  const playPauseBtn = document.getElementById('play-pause-btn')!;
  let playing = true;
  let playInterval: ReturnType<typeof setInterval> | null = null;

  function startPlay() {
    playInterval = setInterval(() => {
      progress = Math.min(progress + 0.2, 98);
      if (progressBar) progressBar.style.width = progress + '%';
    }, 500);
  }
  function stopPlay() {
    if (playInterval) clearInterval(playInterval);
    playInterval = null;
  }
  startPlay();

  playPauseBtn.addEventListener('click', () => {
    playing = !playing;
    const icon = playPauseBtn.querySelector('#play-icon')!;
    if (playing) {
      playPauseBtn.setAttribute('aria-label', 'Pause live feed');
      icon.innerHTML = `<rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>`;
      startPlay();
    } else {
      playPauseBtn.setAttribute('aria-label', 'Resume live feed');
      icon.innerHTML = `<polygon points="5 3 19 12 5 21 5 3"/>`;
      stopPlay();
    }
  });

  // ── Filter pills ───────────────────────────────────────
  document.querySelectorAll('.filter-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-pill').forEach(p => {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      });
      (pill as HTMLElement).classList.add('active');
      pill.setAttribute('aria-pressed', 'true');
    });
  });

  // ── Real-time event simulation ─────────────────────────
  let alertCount = 7;
  const alertCountEl = document.getElementById('live-alert-count')!;
  const alertFeedEl  = document.getElementById('alert-feed')!;

  function addAlert(event: {type:string;camera:string;location:string;detection:string;confidence:number;timestamp:string;severity:string;id:string}) {
    const isCrit = event.severity === 'critical';
    const color  = isCrit ? 'var(--color-critical)' : event.severity === 'high' ? 'var(--color-warning)' : 'var(--color-safe)';
    const dotCls = isCrit ? 'critical' : event.severity === 'high' ? 'warning' : 'safe';

    const el = document.createElement('div');
    el.className = `alert-item${isCrit ? ' critical-item' : ''} new`;
    el.setAttribute('role', 'article');
    el.setAttribute('tabindex', '0');
    el.setAttribute('data-open-drawer', '');
    el.setAttribute('data-incident-id', event.id);
    el.setAttribute('data-detection', event.detection);
    el.setAttribute('data-camera', event.camera);
    el.setAttribute('data-location', event.location);
    el.setAttribute('data-confidence', String(Math.round(event.confidence * 100)));
    el.setAttribute('data-severity', event.severity);
    el.setAttribute('data-timestamp', event.timestamp);
    el.setAttribute('aria-label', `New ${event.severity} alert: ${event.detection}. ${event.camera}. ${event.timestamp}.`);
    el.innerHTML = `
      <span class="status-dot ${dotCls}" style="margin-top:4px;flex-shrink:0;" aria-hidden="true"></span>
      <div class="alert-item-body">
        <div class="alert-item-title">${event.detection}</div>
        <div class="alert-item-meta">${event.camera} · ${event.location}</div>
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div class="tech-label">${event.timestamp}</div>
        <div style="font-size:9px;font-weight:700;color:${color};margin-top:1px;">${Math.round(event.confidence*100)}%</div>
      </div>
    `;

    // Insert at top of feed
    alertFeedEl.insertBefore(el, alertFeedEl.firstChild);
    // Emit the alert first. Context failure must never delay its delivery.
    void requestIncidentContext(event).then(context => {
      el.dataset.contextStatus = context.status;
      el.title = `TinyFish context: ${context.status}. Open to review sources.`;
    }).catch(() => { el.dataset.contextStatus = 'unavailable'; });

    // Remove oldest if too many
    const allItems = alertFeedEl.querySelectorAll('.alert-item');
    if (allItems.length > 8) allItems[allItems.length - 1]?.remove();

    // Update counter
    alertCount++;
    if (alertCountEl) alertCountEl.textContent = String(alertCount);

    // Flash violation bbox
    const bbox = document.getElementById('violation-bbox');
    if (bbox && isCrit) {
      bbox.style.boxShadow = '0 0 20px var(--color-critical-glow)';
      setTimeout(() => { bbox.style.boxShadow = ''; }, 2000);
    }
  }

  // Register to receive simulation events
  let simInterval: ReturnType<typeof setInterval> | null = null;

  function scheduleNextEvent() {
    const delay = 8000 + Math.random() * 12000;
    simInterval = setTimeout(() => {
      const events = [
        { type:'critical_incident', camera:'CAM-04', cameraName:'Sector B — Crane Zone', location:'Sector B', detection:'No Hard Hat', confidence:0.98, severity:'critical' },
        { type:'warning', camera:'CAM-03', cameraName:'Sector B — Entry', location:'Sector B', detection:'Zone Proximity Alert', confidence:0.91, severity:'high' },
        { type:'critical_incident', camera:'CAM-01', cameraName:'North Tower — Level 08', location:'North Tower / L08', detection:'No Safety Vest', confidence:0.93, severity:'critical' },
        { type:'warning', camera:'CAM-06', cameraName:'Loading Bay', location:'Loading Bay East', detection:'PPE Degradation', confidence:0.85, severity:'high' },
      ];
      const ev = events[Math.floor(Math.random() * events.length)];
      const ts = new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
      const id = `INC-0${249 + alertCount}`;
      addAlert({ ...ev, timestamp: ts, id });
      scheduleNextEvent();
    }, delay);
  }

  scheduleNextEvent();

  // Hook into global demo button
  (window as any).__sitesage_simulate_critical = () => {
    const ts = new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    addAlert({
      type: 'critical_incident', camera: 'CAM-04',
      location: 'North Tower / Sector B', detection: 'No Hard Hat',
      confidence: 0.98, timestamp: ts, severity: 'critical',
      id: `INC-0${249 + alertCount}`,
    });
  };

  // ── Worker Profile Modal Interactions ─────────────────────
  const workerModal = document.getElementById('modal-worker-profile');
  const workerAvatar = document.getElementById('worker-modal-avatar');
  const workerNameEl = document.getElementById('worker-modal-name');
  const workerBadgeEl = document.getElementById('worker-modal-badge');
  const workerTradeEl = document.getElementById('worker-modal-trade');
  const workerSubEl = document.getElementById('worker-modal-sub');
  const workerForemanEl = document.getElementById('worker-modal-foreman');
  const workerStreakEl = document.getElementById('worker-modal-streak');
  const workerRatingEl = document.getElementById('worker-modal-rating');
  const workerObsBox = document.getElementById('worker-modal-obs-box');

  const workerDB: Record<string, any> = {
    'SC-4891': {
      name: 'Marcus "Mack" Vance',
      badge: '#SC-4891',
      avatar: 'MV',
      trade: 'Journeyman Ironworker (Local 40)',
      sub: 'SteelCorp Heavy Erectors',
      foreman: 'Frank Delgado (Radio Ch 4)',
      streak: '84 Consecutive Shifts',
      rating: '94.2% Compliance',
      obs: 'Field observation: Marcus set hard hat on gangbox to adjust crane tagline. Radio dispatched to Foreman Frank Delgado for on-site correction.',
      hasAlert: true
    },
    'AC-0924': {
      name: 'Elena Rostova-Chen',
      badge: '#AC-0924',
      avatar: 'EC',
      trade: 'Lead Concrete Finisher',
      sub: 'Apex Concrete Ltd.',
      foreman: 'Ray Kowalski (Radio Ch 2)',
      streak: '192 Consecutive Shifts',
      rating: '99.1% Compliance',
      obs: 'Full compliance verified on Level 08 deck. Safety harness tethered to static line.',
      hasAlert: false
    },
    'MC-1102': {
      name: 'Jorge "Kiko" Reyes',
      badge: '#MC-1102',
      avatar: 'JR',
      trade: 'Certified Crane Rigger',
      sub: 'Metro Crane Specialists',
      foreman: 'Bill Henderson (Liebherr Operator)',
      streak: '140 Consecutive Shifts',
      rating: '96.5% Compliance',
      obs: 'Outrigger pads placement verified. Operating within clear radius.',
      hasAlert: false
    }
  };

  function openWorkerProfile(wid: string) {
    const data = workerDB[wid] || workerDB['SC-4891'];
    if (!workerModal) return;
    if (workerAvatar) workerAvatar.textContent = data.avatar;
    if (workerNameEl) workerNameEl.textContent = data.name;
    if (workerBadgeEl) workerBadgeEl.textContent = data.badge;
    if (workerTradeEl) workerTradeEl.textContent = data.trade;
    if (workerSubEl) workerSubEl.textContent = data.sub;
    if (workerForemanEl) workerForemanEl.textContent = data.foreman;
    if (workerStreakEl) workerStreakEl.textContent = data.streak;
    if (workerRatingEl) workerRatingEl.textContent = data.rating;
    if (workerObsBox) {
      workerObsBox.style.display = data.hasAlert ? 'block' : 'none';
      const textEl = workerObsBox.querySelector('div:last-child');
      if (textEl) textEl.textContent = data.obs;
    }
    workerModal.style.display = 'flex';
  }

  document.querySelectorAll('[data-open-worker-modal]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const wid = el.getAttribute('data-open-worker-modal') || 'SC-4891';
      openWorkerProfile(wid);
    });
  });

  document.querySelectorAll('.humanoid-worker').forEach(el => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const wid = el.getAttribute('data-worker-id') || 'SC-4891';
      openWorkerProfile(wid);
    });
  });
</script>

<WorkerProfileModal />

</Layout>
