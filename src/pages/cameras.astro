    model: 'Hanwha Techwin PTZ 4K',
    res: '4K (3840×2160)',
    fps: 30,
    bitrate: '8.8 Mbps',
    codec: 'H.265 / HEVC',
    latency: '16 ms',
    packetLoss: '0.01%',
    status: 'online',
    health: 99,
    uptime: '94d 06h',
    aiPipelines: ['PerimeterTripwire', 'IR-NightVision'],
    workers: 2,
    activeThreats: 0,
  },
  {
    id: 'CAM-09',
    name: 'Excavation Pit — Trench B-2',
    sector: 'Sector B',
    ip: '10.0.1.109',
    url: 'rtsp://10.0.1.109:554/live/main',
    model: 'Bosch Flexidome IP 5000',
    res: '1080p (1920×1080)',
    fps: 14,
    bitrate: '1.9 Mbps',
    codec: 'H.264',
    latency: '92 ms',
    packetLoss: '3.12%',
    status: 'warning',
    health: 68,
    uptime: '04d 18h',
    aiPipelines: ['ShoringCollapseWatch', 'YOLOv8-PPE'],
    workers: 5,
    activeThreats: 1,
  },
  {
    id: 'CAM-10',
    name: 'Electrical Substation Perimeter',
    sector: 'Sector E',
    ip: '10.0.1.110',
    url: 'rtsp://10.0.1.110:554/live/main',
    model: 'Axis M3075-V Compact',
    res: '1080p (1920×1080)',
    fps: 0,
    bitrate: '0.0 Mbps',
    codec: 'Offline',
    latency: 'Host Unreachable',
