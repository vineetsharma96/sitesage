const onlineCount = cameras.filter(c => c.status === 'online').length;
const warningCount = cameras.filter(c => c.status === 'warning').length;
const offlineCount = cameras.filter(c => c.status === 'offline').length;
---

<Layout
  title="Camera Network"
  breadcrumb={['Site Dashboard', 'Camera Network']}
  activePage="cameras"
>

<!-- TOP BANNER -->
<div class="page-header">
  <div>
    <h1 class="page-title">Camera Network & Telemetry</h1>
    <p class="page-subtitle">27 RTSP edge nodes • AI vision pipelines • Real-time frame health & latency</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost btn-sm" id="btn-refresh-all">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
      </svg>
      Ping Network
    </button>
    <button class="btn btn-primary btn-sm" id="btn-add-camera">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Register Camera
    </button>
  </div>
</div>

<!-- OPS STATUS METRIC STRIP -->
<div class="ops-status-strip camera-telemetry" role="region" aria-label="Network Telemetry Summary">
  <div class="ops-status-item">
    <span class="status-dot safe" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Online Streams</div>
      <div class="ops-status-value" style="color:var(--color-safe);"><span>{onlineCount}</span><small>/ {cameras.length} nodes</small></div>
    </div>
  </div>
  <div class="ops-status-item">
    <span class="status-dot warning" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Degraded Latency</div>
      <div class="ops-status-value" style="color:var(--color-warning);"><span>{warningCount}</span><small>streams</small></div>
    </div>
  </div>
  <div class="ops-status-item">
    <span class="status-dot critical" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Offline Feeds</div>
      <div class="ops-status-value" style="color:var(--color-critical);"><span>{offlineCount}</span><small>nodes</small></div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" aria-hidden="true">
      <path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
    </svg>
    <div>
      <div class="ops-status-label">Aggregate Bandwidth</div>
      <div class="ops-status-value"><span>842.6</span><small>Mbps</small></div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-safe)" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    </svg>
    <div>
      <div class="ops-status-label">Edge Ingestion Ping</div>
      <div class="ops-status-value" style="color:var(--color-safe);"><span>21</span><small>ms avg</small></div>
    </div>
  </div>
  <div class="ops-status-item" style="border-right:none;">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-hover)" stroke-width="2" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
    </svg>
    <div>
      <div class="ops-status-label">TensorRT GPU Load</div>
      <div class="ops-status-value"><span>68%</span><small>42 FPS</small></div>
    </div>
  </div>
</div>

<!-- FILTER & VIEW CONTROLS -->
<div class="card" style="padding:10px 14px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
  <!-- Filter Pills -->
  <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
    <button class="filter-tab active" data-filter="all">All Cameras ({cameras.length})</button>
    <button class="filter-tab" data-filter="online">Online ({onlineCount})</button>
    <button class="filter-tab" data-filter="warning">Degraded ({warningCount})</button>
    <button class="filter-tab" data-filter="offline">Offline ({offlineCount})</button>
    <span style="color:var(--color-border);margin:0 4px;">|</span>
    <select class="input" id="sector-select" style="width:auto;height:30px;font-size:11px;padding:2px 8px;" aria-label="Filter by Sector">
      <option value="all">All Sectors</option>
      <option value="Sector A">Sector A — North Tower</option>
      <option value="Sector B">Sector B — Crane Staging</option>
      <option value="Sector C">Sector C — South Tower</option>
      <option value="Sector D">Sector D — Loading Bay</option>
      <option value="Sector E">Sector E — Perimeter</option>
    </select>
  </div>

  <!-- Search and View Switch -->
  <div style="display:flex;align-items:center;gap:8px;">
    <div class="input-icon-wrap" style="width:220px;position:relative;">
      <svg style="position:absolute;left:8px;top:50%;transform:translateY(-50%);color:var(--color-text-tertiary);" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="search"
        id="camera-search"
        class="input"
        placeholder="Filter by ID, IP, or model..."
        style="padding-left:28px;height:30px;font-size:11px;"
        aria-label="Filter camera list"
      />
    </div>

    <!-- Toggle View Mode -->
    <div style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-sm);overflow:hidden;">
      <button class="view-btn active" id="view-cards-btn" title="Feed Cards View" aria-label="Cards View">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
      </button>
      <button class="view-btn" id="view-table-btn" title="Technical Registry Table View" aria-label="Table View">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- VIEW 1: FEED CARDS GRID -->
<div id="cards-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(340px, 1fr));gap:16px;">
  {cameras.map(cam => (
    <div
      class="camera-card-item card"
      data-id={cam.id}
      data-status={cam.status}
      data-sector={cam.sector}
      data-name={cam.name}
      data-ip={cam.ip}
      style="padding:0;overflow:hidden;display:flex;flex-direction:column;border-color:var(--color-border);transition:border-color 0.2s;"
    >
      <!-- Simulated Video Feed Frame -->
      <div style="position:relative;background:#060a12;aspect-ratio:16/9;overflow:hidden;display:flex;align-items:center;justify-content:center;">
        {cam.status === 'offline' ? (
          <div style="text-align:center;color:var(--color-text-tertiary);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-critical)" stroke-width="1.5" style="margin:0 auto 8px;">
              <line x1="1" y1="1" x2="23" y2="23"/>
              <path d="M21 21H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3m3-3h6l2 3h4a2 2 0 0 1 2 2v9.34"/>
            </svg>
            <div style="font-family:var(--font-mono);font-size:12px;color:var(--color-critical);font-weight:600;">NO SIGNAL / RTSP TIMEOUT</div>
            <div style="font-size:10px;margin-top:2px;">Check PoE power injector or fiber switch port</div>
          </div>
        ) : (
          <>
            <!-- Simulated CCTV background elements -->
            <svg viewBox="0 0 400 225" style="position:absolute;inset:0;width:100%;height:100%;opacity:0.6;">
              <!-- Construction site schematic silhouettes -->
              <rect x="0" y="160" width="400" height="65" fill="#0d1829"/>
              <line x1="40" y1="160" x2="40" y2="40" stroke="#1f293d" stroke-width="3"/>
              <line x1="120" y1="160" x2="120" y2="20" stroke="#1f293d" stroke-width="4"/>
              <line x1="260" y1="160" x2="260" y2="70" stroke="#1f293d" stroke-width="3"/>
              <line x1="20" y1="40" x2="160" y2="20" stroke="#1e3a5f" stroke-width="1.5" stroke-dasharray="4,4"/>
              <!-- Scaffolding cross-braces -->
              <line x1="40" y1="40" x2="120" y2="100" stroke="#16253b" stroke-width="1"/>
              <line x1="40" y1="100" x2="120" y2="40" stroke="#16253b" stroke-width="1"/>
              <!-- Workers detected -->
              {cam.status === 'online' && (
                <>
                  <rect x="70" y="90" width="34" height="65" fill="none" stroke="#10B981" stroke-width="1.5" stroke-dasharray="3,2"/>
                  <text x="70" y="85" fill="#10B981" font-size="8" font-family="monospace">P01 [98% PPE]</text>
                  <rect x="220" y="110" width="36" height="50" fill="none" stroke={cam.activeThreats > 0 ? '#EF4444' : '#10B981'} stroke-width="1.5"/>
                  <text x="220" y="105" fill={cam.activeThreats > 0 ? '#EF4444' : '#10B981'} font-size="8" font-family="monospace">
                    {cam.activeThreats > 0 ? 'VIOLATION: NO-HELMET' : 'P02 [94% PPE]'}
                  </text>
                </>
              )}
            </svg>

            <!-- Video Scanline Scan Bar -->
            <div class="cctv-scanline" style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg, transparent, rgba(59,130,246,0.06), transparent);animation:scanline 4s linear infinite;"></div>

            <!-- CCTV HUD Overlay -->
            <div style="position:absolute;top:8px;left:8px;display:flex;align-items:center;gap:6px;background:rgba(11,18,32,0.75);backdrop-filter:blur(4px);padding:2px 6px;border-radius:3px;border:1px solid rgba(255,255,255,0.08);">
              <span class={`status-dot ${cam.status === 'online' ? 'safe' : 'warning'}`}></span>
              <span style="font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:0.04em;">{cam.id}</span>
              <span style="color:var(--color-text-tertiary);font-size:9px;">•</span>
              <span style="font-family:var(--font-mono);font-size:9px;color:var(--color-text-secondary);">{cam.res.split(' ')[0]}</span>
            </div>

            <div style="position:absolute;top:8px;right:8px;background:rgba(11,18,32,0.75);backdrop-filter:blur(4px);padding:2px 6px;border-radius:3px;font-family:var(--font-mono);font-size:10px;color:var(--color-safe);border:1px solid rgba(16,185,129,0.2);">
              REC • {cam.fps} FPS
            </div>

            <!-- Threat badge overlay if critical -->
            {cam.activeThreats > 0 && (
              <div style="position:absolute;bottom:8px;left:8px;background:rgba(239,68,68,0.9);color:#fff;font-family:var(--font-mono);font-size:9px;font-weight:700;padding:2px 6px;border-radius:2px;letter-spacing:0.04em;display:flex;align-items:center;gap:4px;">
                <span style="display:inline-block;width:5px;height:5px;background:#fff;border-radius:50%;animation:blink 1s infinite;"></span>
                {cam.activeThreats} ACTIVE {cam.activeThreats === 1 ? 'ALERT' : 'ALERTS'}
              </div>
            )}
          </>
        )}
      </div>

      <!-- Card Details & Telemetry -->
      <div style="padding:14px;flex:1;display:flex;flex-direction:column;justify-content:space-between;gap:12px;">
        <div>
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px;">
            <div>
              <div style="font-weight:600;font-size:13px;color:var(--color-text-primary);">{cam.name}</div>
              <div style="font-size:11px;color:var(--color-text-tertiary);font-family:var(--font-mono);margin-top:2px;">
                {cam.model} • {cam.sector}
              </div>
            </div>
            <span class={`badge ${cam.status === 'online' ? 'badge-safe' : cam.status === 'warning' ? 'badge-warning' : 'badge-critical'}`} style="font-size:10px;">
              {cam.status.toUpperCase()}
            </span>
          </div>

          <!-- Network Metrics Mini Grid -->
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;background:rgba(255,255,255,0.02);border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:8px;margin-top:8px;">
            <div>
              <div style="font-size:9px;color:var(--color-text-tertiary);text-transform:uppercase;">Bitrate</div>
              <div style="font-family:var(--font-mono);font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-top:2px;">{cam.bitrate}</div>
            </div>
            <div>
              <div style="font-size:9px;color:var(--color-text-tertiary);text-transform:uppercase;">Latency</div>
              <div style={`font-family:var(--font-mono);font-size:11px;font-weight:600;margin-top:2px;color:${cam.latency.includes('ms') && parseInt(cam.latency)<50 ? 'var(--color-safe)' : cam.status==='offline' ? 'var(--color-critical)' : 'var(--color-warning)'};`}>
                {cam.latency}
              </div>
            </div>
            <div>
              <div style="font-size:9px;color:var(--color-text-tertiary);text-transform:uppercase;">Health</div>
              <div style={`font-family:var(--font-mono);font-size:11px;font-weight:600;margin-top:2px;color:${cam.health>85 ? 'var(--color-safe)' : cam.health>50 ? 'var(--color-warning)' : 'var(--color-critical)'};`}>
                {cam.health}%
              </div>
            </div>
          </div>

          <!-- Attached AI Pipelines -->
          <div style="margin-top:10px;">
            <div style="font-size:10px;font-weight:600;color:var(--color-text-tertiary);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:4px;">
              Active Vision Models
            </div>
            <div style="display:flex;gap:4px;flex-wrap:wrap;">
              {cam.aiPipelines.map(pipe => (
                <span style="font-size:9px;font-family:var(--font-mono);background:rgba(37,99,235,0.12);color:var(--color-primary);border:1px solid rgba(59,130,246,0.3);padding:1px 5px;border-radius:3px;">
                  {pipe}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid var(--color-border);gap:6px;">
          <a href="/monitoring" class="btn btn-ghost btn-sm" style="flex:1;justify-content:center;font-size:11px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 7 16 12 23 17V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/>
            </svg>
            Live Feed
          </a>
          <button class="btn btn-secondary btn-sm btn-diag" data-cam-id={cam.id} style="flex:1;justify-content:center;font-size:11px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            Telemetry
          </button>
        </div>
      </div>
    </div>
  ))}
</div>

<!-- VIEW 2: TECHNICAL REGISTRY TABLE (hidden by default) -->
<div id="table-container" class="card" style="display:none;overflow:hidden;padding:0;">
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:12px;text-align:left;">
      <thead>
        <tr style="background:rgba(255,255,255,0.02);border-bottom:1px solid var(--color-border);">
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-family:var(--font-mono);font-size:10px;text-transform:uppercase;">ID</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">Camera Node & Location</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">RTSP Stream URI</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">Resolution</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">FPS / Codec</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">Bitrate & Loss</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">Status</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;">Health</th>
          <th style="padding:10px 14px;color:var(--color-text-tertiary);font-size:10px;text-transform:uppercase;text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {cameras.map(cam => (
          <tr class="table-cam-row" data-id={cam.id} data-status={cam.status} data-sector={cam.sector} data-name={cam.name} style="border-bottom:1px solid var(--color-border);transition:background 0.15s;">
            <td style="padding:12px 14px;font-family:var(--font-mono);color:var(--color-primary);font-weight:700;">{cam.id}</td>
            <td style="padding:12px 14px;">
              <div style="font-weight:600;color:var(--color-text-primary);">{cam.name}</div>
              <div style="font-size:10px;color:var(--color-text-tertiary);font-family:var(--font-mono);">{cam.model} • {cam.sector}</div>
            </td>
            <td style="padding:12px 14px;font-family:var(--font-mono);font-size:10px;color:var(--color-text-secondary);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              {cam.url}
            </td>
            <td style="padding:12px 14px;font-family:var(--font-mono);">{cam.res.split(' ')[0]}</td>
            <td style="padding:12px 14px;font-family:var(--font-mono);">
              <span style={`color:${cam.fps > 0 ? 'var(--color-text-primary)' : 'var(--color-critical)'};`}>{cam.fps > 0 ? `${cam.fps} FPS` : 'OFFLINE'}</span>
              <div style="font-size:9px;color:var(--color-text-tertiary);">{cam.codec}</div>
            </td>
            <td style="padding:12px 14px;font-family:var(--font-mono);">
              <div>{cam.bitrate}</div>
              <div style={`font-size:9px;color:${parseFloat(cam.packetLoss)>1 ? 'var(--color-critical)' : 'var(--color-text-tertiary)'};`}>loss: {cam.packetLoss}</div>
            </td>
            <td style="padding:12px 14px;">
              <span class={`badge ${cam.status === 'online' ? 'badge-safe' : cam.status === 'warning' ? 'badge-warning' : 'badge-critical'}`} style="font-size:10px;">
                {cam.status}
              </span>
            </td>
            <td style="padding:12px 14px;">
              <div style="display:flex;align-items:center;gap:6px;">
                <div style="width:50px;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;overflow:hidden;">
                  <div style={`height:100%;width:${cam.health}%;background:${cam.health>80 ? 'var(--color-safe)' : cam.health>50 ? 'var(--color-warning)' : 'var(--color-critical)'};`}></div>
                </div>
                <span style="font-family:var(--font-mono);font-size:11px;font-weight:600;">{cam.health}%</span>
              </div>
            </td>
            <td style="padding:12px 14px;text-align:right;">
              <button class="btn btn-ghost btn-sm btn-diag" data-cam-id={cam.id} style="font-size:11px;">
                Diagnostics
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL: REGISTER NEW CAMERA NODE -->
<div id="modal-add-camera" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(6,10,18,0.85);backdrop-filter:blur(6px);z-index:9999;align-items:center;justify-content:center;">
  <div class="card" style="width:100%;max-width:540px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-xl);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:34px;height:34px;border-radius:var(--radius-sm);background:rgba(37,99,235,0.15);border:1px solid var(--color-primary);display:flex;align-items:center;justify-content:center;color:var(--color-primary);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
