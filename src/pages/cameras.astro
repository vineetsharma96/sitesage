      <button class="btn btn-ghost btn-sm" id="btn-close-modal" aria-label="Close modal">✕</button>
    </div>

    <form id="form-register-cam" style="display:flex;flex-direction:column;gap:14px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Camera ID</label>
          <input type="text" class="input" placeholder="e.g. CAM-11" required />
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Sector Assignment</label>
          <select class="input" required>
            <option>Sector A — North Tower</option>
            <option>Sector B — Crane Staging</option>
            <option>Sector C — South Tower</option>
            <option>Sector D — Loading Bay</option>
            <option>Sector E — Perimeter</option>
          </select>
        </div>
      </div>

      <div>
        <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Location Name / Description</label>
        <input type="text" class="input" placeholder="e.g. West Wing Scaffolding Level 04" required />
      </div>

      <div>
        <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">RTSP Stream URI</label>
        <input type="text" class="input" placeholder="rtsp://10.0.1.xxx:554/live/main" style="font-family:var(--font-mono);" required />
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Hardware Model</label>
          <input type="text" class="input" placeholder="e.g. Axis Q1656-LE" />
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Target Inference FPS</label>
          <select class="input">
            <option>30 FPS (Full Real-Time)</option>
            <option>25 FPS (Standard High-Speed)</option>
            <option>15 FPS (Resource Optimized)</option>
            <option>5 FPS (Perimeter Low-Power)</option>
          </select>
        </div>
      </div>

      <div>
        <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">Attach AI Vision Pipelines</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:11px;">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> YOLOv8-PPE Detection
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> Exclusion Geofence
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" /> Proximity & Heavy Machinery
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" /> Worker Fall & Slip Detection
          </label>
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px;padding-top:14px;border-top:1px solid var(--color-border);">
        <button type="button" class="btn btn-ghost" id="btn-cancel-modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Connect & Provision Stream</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: CAMERA DIAGNOSTICS & TELEMETRY -->
<div id="modal-diagnostics" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(6,10,18,0.85);backdrop-filter:blur(6px);z-index:9999;align-items:center;justify-content:center;">
  <div class="card" style="width:100%;max-width:580px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-xl);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div>
        <span class="badge badge-primary" id="diag-cam-id" style="font-family:var(--font-mono);font-size:11px;">CAM-01</span>
        <h2 style="font-size:15px;font-weight:700;color:var(--color-text-primary);margin:4px 0 0 0;" id="diag-cam-name">Diagnostics</h2>
      </div>
      <button class="btn btn-ghost btn-sm" id="btn-close-diag">✕</button>
    </div>

    <!-- Telemetry Cards -->
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;margin-bottom:16px;">
      <div class="card" style="padding:10px;background:rgba(255,255,255,0.02);">
        <div style="font-size:10px;color:var(--color-text-tertiary);">RTSP Status</div>
        <div style="font-size:13px;font-weight:700;color:var(--color-safe);margin-top:2px;">ESTABLISHED</div>
      </div>
      <div class="card" style="padding:10px;background:rgba(255,255,255,0.02);">
        <div style="font-size:10px;color:var(--color-text-tertiary);">Jitter / Latency</div>
        <div style="font-size:13px;font-weight:700;color:var(--color-safe);margin-top:2px;" id="diag-cam-lat">18 ms</div>
      </div>
      <div class="card" style="padding:10px;background:rgba(255,255,255,0.02);">
        <div style="font-size:10px;color:var(--color-text-tertiary);">Buffer Health</div>
        <div style="font-size:13px;font-weight:700;color:var(--color-safe);margin-top:2px;">99.4% OK</div>
      </div>
    </div>

    <!-- Live Ping Waveform SVG -->
    <div style="margin-bottom:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <span style="font-size:11px;font-weight:600;color:var(--color-text-secondary);">Packet Stream Stability (Last 60s)</span>
        <span style="font-size:10px;font-family:var(--font-mono);color:var(--color-safe);">0 drops detected</span>
      </div>
      <div style="background:#060a12;border:1px solid var(--color-border);border-radius:var(--radius-sm);height:80px;padding:8px;position:relative;overflow:hidden;">
        <svg viewBox="0 0 500 64" preserveAspectRatio="none" style="width:100%;height:100%;">
          <path d="M0,45 L40,42 L80,44 L120,38 L160,40 L200,43 L240,39 L280,41 L320,44 L360,40 L400,38 L440,42 L480,40 L500,41" fill="none" stroke="#2563EB" stroke-width="2"/>
          <path d="M0,45 L40,42 L80,44 L120,38 L160,40 L200,43 L240,39 L280,41 L320,44 L360,40 L400,38 L440,42 L480,40 L500,41 L500,64 L0,64 Z" fill="rgba(37,99,235,0.15)"/>
        </svg>
