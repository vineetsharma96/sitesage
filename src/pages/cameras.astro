    packetLoss: '0.35%',
    status: 'online',
    health: 88,
    uptime: '14d 02h',
    aiPipelines: ['BadgeRecognition', 'YOLOv8-PPE'],
    workers: 6,
    activeThreats: 1,
  },
  {
    id: 'CAM-06',
    name: 'East Wing — Heavy Loading Bay',
    sector: 'Sector D',
    ip: '10.0.1.106',
    url: 'rtsp://10.0.1.106:554/live/main',
    model: 'Dahua WizMind PTZ',
    res: '1080p (1920×1080)',
    fps: 12,
    bitrate: '1.4 Mbps',
    codec: 'H.264',
    latency: '115 ms',
    packetLoss: '4.82%',
    status: 'warning',
    health: 64,
    uptime: '01d 22h',
    aiPipelines: ['ForkliftProximity', 'YOLOv8-PPE'],
    workers: 9,
    activeThreats: 3,
  },
  {
    id: 'CAM-07',
    name: 'Sector D — Material Yard Storage',
    sector: 'Sector D',
    ip: '10.0.1.107',
