    bitrate: '3.8 Mbps',
    codec: 'H.265',
    latency: '24 ms',
    packetLoss: '0.08%',
    status: 'online',
    health: 92,
    uptime: '61d 11h',
    aiPipelines: ['YOLOv8-PPE', 'VehiclePedestrian', 'LicensePlate'],
    workers: 7,
    activeThreats: 4,
  },
  {
    id: 'CAM-04',
    name: 'Sector B — Crane #2 Swing Radius',
    sector: 'Sector B',
    ip: '10.0.1.104',
    url: 'rtsp://10.0.1.104:554/live/main',
    model: 'Axis P3245-LVE 4K',
    res: '4K (3840×2160)',
    fps: 30,
    bitrate: '9.1 Mbps',
    codec: 'H.265',
    latency: '19 ms',
    packetLoss: '0.02%',
    status: 'online',
    health: 89,
    uptime: '07d 14h',
    aiPipelines: ['CraneGeofence', 'LoadSuspension', 'YOLOv8-PPE'],
    workers: 4,
    activeThreats: 7,
  },
  {
    id: 'CAM-05',
    name: 'South Tower — Gate C Access',
    sector: 'Sector C',
    ip: '10.0.1.105',
    url: 'rtsp://10.0.1.105:554/live/main',
    model: 'Hikvision DarkFighter 4K',
    res: '720p (1280×720)',
    fps: 15,
    bitrate: '2.1 Mbps',
    codec: 'H.264',
