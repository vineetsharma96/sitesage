    </div>
  </div>
</div>

<style>
.camera-telemetry { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; padding: 0; }
.camera-telemetry .ops-status-item { display: grid; grid-template-columns: 16px minmax(0, 1fr); align-items: start; gap: 12px; min-width: 0; padding: 22px; border: 0; }
.camera-telemetry .ops-status-item > :first-child { margin-top: 5px; flex-shrink: 0; }
.camera-telemetry .ops-status-label { line-height: 1.5; min-height: 2.2rem; }
.camera-telemetry .ops-status-value { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px; font-size: clamp(1rem, 2.2vw, 1.4rem); line-height: 1.5; margin-top: 4px; }
.camera-telemetry .ops-status-value small { font-size: .7rem; font-weight: 400; color: var(--color-text-secondary); white-space: nowrap; }
@media (min-width: 1400px) { .camera-telemetry { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
@media (max-width: 700px) { .camera-telemetry { grid-template-columns: repeat(2, minmax(0, 1fr)); } .camera-telemetry .ops-status-item { padding: 18px 12px; } }
.filter-tab {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 11px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.15s ease;
}
.filter-tab:hover {
  background: rgba(255,255,255,0.04);
  color: var(--color-text-primary);
}
.filter-tab.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
.view-btn {
  background: transparent;
  border: none;
  color: var(--color-text-tertiary);
  padding: 6px 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.view-btn:hover {
  color: var(--color-text-primary);
}
.view-btn.active {
  background: rgba(37,99,235,0.2);
  color: var(--color-primary);
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
@keyframes scanline {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(1000%); }
}
</style>

<script>
  // Filter Tabs
  const filterTabs = document.querySelectorAll('.filter-tab');
  const sectorSelect = document.getElementById('sector-select') as HTMLSelectElement;
  const searchInput = document.getElementById('camera-search') as HTMLInputElement;
  const cardItems = document.querySelectorAll<HTMLElement>('.camera-card-item');
  const tableRows = document.querySelectorAll<HTMLElement>('.table-cam-row');

  function applyFilters() {
    const activeTab = document.querySelector('.filter-tab.active')?.getAttribute('data-filter') || 'all';
    const sector = sectorSelect?.value || 'all';
    const query = searchInput?.value.toLowerCase().trim() || '';

    const filterItem = (el: HTMLElement) => {
      const status = el.dataset.status || '';
      const sec = el.dataset.sector || '';
      const name = (el.dataset.name || '').toLowerCase();
      const id = (el.dataset.id || '').toLowerCase();
      const ip = (el.dataset.ip || '').toLowerCase();

      const matchTab = activeTab === 'all' || status === activeTab;
      const matchSector = sector === 'all' || sec === sector;
      const matchQuery = !query || name.includes(query) || id.includes(query) || ip.includes(query);

      el.style.display = (matchTab && matchSector && matchQuery) ? '' : 'none';
    };

    cardItems.forEach(filterItem);
    tableRows.forEach(filterItem);
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      applyFilters();
    });
  });

  sectorSelect?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);

  // View Mode Switcher
  const viewCardsBtn = document.getElementById('view-cards-btn');
  const viewTableBtn = document.getElementById('view-table-btn');
  const cardsContainer = document.getElementById('cards-container');
  const tableContainer = document.getElementById('table-container');

  viewCardsBtn?.addEventListener('click', () => {
    viewCardsBtn.classList.add('active');
    viewTableBtn?.classList.remove('active');
    if (cardsContainer) cardsContainer.style.display = 'grid';
    if (tableContainer) tableContainer.style.display = 'none';
  });

  viewTableBtn?.addEventListener('click', () => {
    viewTableBtn.classList.add('active');
    viewCardsBtn?.classList.remove('active');
    if (cardsContainer) cardsContainer.style.display = 'none';
    if (tableContainer) tableContainer.style.display = 'block';
  });

  // Modal Provisioning
  const addModal = document.getElementById('modal-add-camera');
  const btnAddCamera = document.getElementById('btn-add-camera');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const formRegisterCam = document.getElementById('form-register-cam');

  btnAddCamera?.addEventListener('click', () => {
    if (addModal) addModal.style.display = 'flex';
  });

  const hideModal = () => {
    if (addModal) addModal.style.display = 'none';
  };

  btnCloseModal?.addEventListener('click', hideModal);
  btnCancelModal?.addEventListener('click', hideModal);
  formRegisterCam?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Camera node successfully registered! RTSP handshake complete.');
    hideModal();
  });

  // Diagnostics Modal
  const diagModal = document.getElementById('modal-diagnostics');
  const btnCloseDiag = document.getElementById('btn-close-diag');
  const diagCamId = document.getElementById('diag-cam-id');
  const diagCamName = document.getElementById('diag-cam-name');
  const diagBtns = document.querySelectorAll('.btn-diag');

  diagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cid = btn.getAttribute('data-cam-id') || 'CAM-01';
      if (diagCamId) diagCamId.textContent = cid;
      if (diagCamName) diagCamName.textContent = `Diagnostic Telemetry — ${cid}`;
      if (diagModal) diagModal.style.display = 'flex';
    });
  });

  btnCloseDiag?.addEventListener('click', () => {
    if (diagModal) diagModal.style.display = 'none';
  });

  document.getElementById('btn-refresh-all')?.addEventListener('click', () => {
    alert('Pinging all 27 RTSP edge nodes... 22 responsive, 3 high jitter, 2 timeout.');
  });
  document.getElementById('btn-reboot-node')?.addEventListener('click', () => {
    alert('Signal sent to edge gateway: restarting GStreamer RTSP pipeline.');
  });
  document.getElementById('btn-calibrate-model')?.addEventListener('click', () => {
    alert('Calibration initiated: YOLOv8 dynamic anchors synchronized.');
  });
</script>

</Layout>
