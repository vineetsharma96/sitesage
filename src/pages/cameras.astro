const cameras = [
  {
    id: 'CAM-01',
    name: 'North Tower — Level 08 Deck',
    sector: 'Sector A',
    ip: '10.0.1.101',
    url: 'rtsp://10.0.1.101:554/live/main',
    model: 'Axis Q1656-LE 4K',
    res: '4K (3840×2160)',
